generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("OPERATOR") // ADMIN, OPERATOR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cashSessions CashSession[]
}

model Vehicle {
  id          String       @id @default(uuid())
  plate       String       @unique
  type        String       // CAR, MOTORCYCLE
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tickets     Ticket[]
  memberships Membership[]
}

model ParkingSpot {
  id        String      @id @default(uuid())
  number    String      @unique
  type      String      // CAR, MOTORCYCLE
  status    String      @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE
  row       Int         @default(0)
  column    Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tickets   Ticket[]
}

model ParkingRate {
  id              String      @id @default(uuid())
  name            String
  vehicleType     String      // CAR, MOTORCYCLE
  baseFee         Float       @default(0)
  baseTimeMinutes Int         @default(0)
  hourlyRate      Float
  dailyMax        Float?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tickets         Ticket[]
}

model MembershipPlan {
  id           String       @id @default(uuid())
  name         String
  description  String?
  price        Float
  durationDays Int          @default(30)
  vehicleType  String       // CAR, MOTORCYCLE
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Membership {
  id              String           @id @default(uuid())
  planId          String
  plan            MembershipPlan   @relation(fields: [planId], references: [id])
  vehicleId       String
  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id])
  startDate       DateTime         @default(now())
  endDate         DateTime
  status          String           @default("ACTIVE") // ACTIVE, EXPIRED, CANCELED
  lastPaymentDate DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Ticket {
  id            String       @id @default(uuid())
  vehicleId     String
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id])
  spotId        String
  spot          ParkingSpot @relation(fields: [spotId], references: [id])
  rateId        String?
  rate          ParkingRate? @relation(fields: [rateId], references: [id])
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])
  entryTime     DateTime     @default(now())
  exitTime      DateTime?
  fee           Float?
  status        String       @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model CashSession {
  id             String    @id @default(uuid())
  openingTime    DateTime  @default(now())
  closingTime    DateTime?
  initialAmount  Float     @default(0)
  expectedAmount Float     @default(0) // initialAmount + totalIncome
  totalIncome    Float     @default(0) // sum of ticket fees
  actualAmount   Float?
  difference     Float?
  notes          String?
  status         String    @default("OPEN") // OPEN, CLOSED
  openedByName   String?
  closedByName   String?
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  tickets        Ticket[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
